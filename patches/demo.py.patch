+def load_calibration(path):
+    try:
+        with open(path, 'r', encoding='utf-8') as calibration_file:
+            return json.load(calibration_file)
+    except (FileNotFoundError, json.JSONDecodeError):
+        return None
+
+
+def save_calibration(path, calibration):
+    with open(path, 'w', encoding='utf-8') as calibration_file:
+        json.dump(calibration, calibration_file, indent=2)
+
+
+def build_calibration(samples):
+    means = {}
+    for target, values in samples.items():
+        if not values:
+            raise RuntimeError('No samples collected for {}'.format(target))
+        means[target] = [
+            sum(value[axis] for value in values) / len(values)
+            for axis in (0, 1)
+        ]
+    center = means['CENTER']
+    horizontal_scale = (
+        abs(means['LEFT'][0] - center[0]) +
+        abs(means['RIGHT'][0] - center[0])) / 2
+    vertical_scale = (
+        abs(means['UP'][1] - center[1]) +
+        abs(means['DOWN'][1] - center[1])) / 2
+
+    # Per-side scales: one shared scale under-reads the weaker side (camera
+    # off-centre, head turned during calibration), so looking that way could
+    # never reach the eye-contact threshold. Only trusted when each target
+    # moved the iris the expected way (LEFT/UP negative, RIGHT/DOWN positive).
+    def side_scales(neg_key, pos_key, axis, shared):
+        neg = means[neg_key][axis] - center[axis]
+        pos = means[pos_key][axis] - center[axis]
+        if neg >= 0 or pos <= 0:
+            return None, None
+        floor = 0.5 * shared    # stop one noisy side from over-amplifying
+        return max(-neg, floor), max(pos, floor)
+
+    left_scale, right_scale = side_scales(
+        'LEFT', 'RIGHT', 0, horizontal_scale)
+    up_scale, down_scale = side_scales(
+        'UP', 'DOWN', 1, vertical_scale)
+    return {
+        'means': means,
+        'center': center,
+        'horizontal_scale': horizontal_scale,
+        'vertical_scale': vertical_scale,
+        'vertical_valid': vertical_scale >= 0.03,
+        'left_scale': left_scale,
+        'right_scale': right_scale,
+        'up_scale': up_scale,
+        'down_scale': down_scale,
+    }
+
+
+def scaled_angle(delta, calibration, axis):
+    """15 deg == the calibrated target on the side the iris moved toward.
+
+    Calibration files saved before per-side scales existed only have the
+    shared horizontal_scale / vertical_scale, so fall back to those.
+    """
+    if axis == 'x':
+        neg_key, pos_key, shared_key = 'left_scale', 'right_scale', 'horizontal_scale'
+    else:
+        neg_key, pos_key, shared_key = 'up_scale', 'down_scale', 'vertical_scale'
+    scale = calibration.get(neg_key if delta < 0 else pos_key)
+    return 15.0 * delta / (scale or calibration[shared_key])
+
+
+def calculate_gaze_info(left_eye, right_eye, left_center, right_center,
+                        threshold_degrees, calibration=None,
+                        vertical_threshold_degrees=30.0):
+    eye_centers = [
+        ((left_eye[0] + left_eye[2]) / 2,
+         (left_eye[1] + left_eye[3]) / 2),
+        ((right_eye[0] + right_eye[2]) / 2,
+         (right_eye[1] + right_eye[3]) / 2),
+    ]
+    iris_centers = [left_center, right_center]
+    ratios = []
+
+    for eye_center, iris_center, eye_bbox in zip(
+            eye_centers, iris_centers, (left_eye, right_eye)):
+        half_width = max((eye_bbox[2] - eye_bbox[0]) / 2, 1)
+        ratios.append(((iris_center[0] - eye_center[0]) / half_width,
+                   (iris_center[1] - eye_center[1]) / half_width))
+
+    ratio_x = sum(ratio[0] for ratio in ratios) / len(ratios)
+    ratio_y = sum(ratio[1] for ratio in ratios) / len(ratios)
+    raw_ratio_x = ratio_x
+    raw_ratio_y = ratio_y
+    if calibration:
+        ratio_x -= calibration['center'][0]
+        ratio_y -= calibration['center'][1]
+        angle_x = scaled_angle(ratio_x, calibration, 'x')
+        angle_y = (scaled_angle(ratio_y, calibration, 'y')
+                   if calibration.get('vertical_valid', False) else 0.0)
+    else:
+        angle_x = math.degrees(math.atan2(ratio_x, 2.0))
+        angle_y = math.degrees(math.atan2(ratio_y, 2.0))
+
+    return {
+        'ratio_x': ratio_x,
+        'ratio_y': ratio_y,
+        'raw_ratio_x': raw_ratio_x,
+        'raw_ratio_y': raw_ratio_y,
+        'angle_x': angle_x,
+        'angle_y': angle_y,
+        'threshold': threshold_degrees,
+        'eye_contact': (abs(angle_x) <= threshold_degrees and
+                (not calibration or
+                 not calibration.get('vertical_valid', False) or
+                 abs(angle_y) <= vertical_threshold_degrees)),
+        'center': (
+            int((left_center[0] + right_center[0]) / 2),
+            int((left_center[1] + right_center[1]) / 2)),
+    }
+
+
+def smooth_ratio(previous, ratio_x, ratio_y, alpha=0.25):
+    if previous is None:
+        return ratio_x, ratio_y
+    return (
+        previous[0] + alpha * (ratio_x - previous[0]),
+        previous[1] + alpha * (ratio_y - previous[1]),
+    )
+
+
+def apply_ratio_to_gaze_info(gaze_info, ratio, calibration,
+                             threshold_degrees, vertical_threshold_degrees):
+    raw_ratio_x, raw_ratio_y = gaze_info['raw_ratio_x'], gaze_info['raw_ratio_y']
+    ratio_x, ratio_y = ratio
+    if calibration:
+        ratio_x -= calibration['center'][0]
+        ratio_y -= calibration['center'][1]
+        angle_x = scaled_angle(ratio_x, calibration, 'x')
+        angle_y = (scaled_angle(ratio_y, calibration, 'y')
+                   if calibration.get('vertical_valid', False) else 0.0)
+        vertical_ok = (not calibration.get('vertical_valid', False) or
+                        abs(angle_y) <= vertical_threshold_degrees)
+    else:
+        angle_x = math.degrees(math.atan2(ratio_x, 2.0))
+        angle_y = math.degrees(math.atan2(ratio_y, 2.0))
+        vertical_ok = abs(angle_y) <= vertical_threshold_degrees
+    gaze_info.update({
+        'ratio_x': ratio_x,
+        'ratio_y': ratio_y,
+        'angle_x': angle_x,
+        'angle_y': angle_y,
+        'threshold': threshold_degrees,
+        'eye_contact': abs(angle_x) <= threshold_degrees and vertical_ok,
+    })
+    return gaze_info
+
+
+def draw_calibration_target(debug_image, target, elapsed):
+    height, width = debug_image.shape[:2]
+    positions = {
+        'CENTER': (width // 2, height // 2),
+        'LEFT': (width // 5, height // 2),
+        'RIGHT': (width * 4 // 5, height // 2),
+        'UP': (width // 2, height // 5),
+        'DOWN': (width // 2, height * 4 // 5),
+    }
+    point = positions[target]
+    cv.circle(debug_image, point, 14, (0, 255, 255), -1)
+    cv.putText(debug_image, 'Look at {} ({:.1f}/4.0s)'.format(
+        target, min(elapsed, 4.0)), (10, 115), cv.FONT_HERSHEY_SIMPLEX,
+        0.8, (0, 255, 255), 2, cv.LINE_AA)
+    return debug_image
+
+
+def draw_gaze_overlay(debug_image, gaze_info):
+    center = (int(gaze_info['center'][0]), int(gaze_info['center'][1]))
+    end = (center[0] + int(gaze_info['ratio_x'] * 80),
+           center[1] + int(gaze_info['ratio_y'] * 80))
+    color = (0, 255, 0) if gaze_info['eye_contact'] else (0, 255, 255)
+    cv.arrowedLine(debug_image, center, end, color, 2, cv.LINE_AA, 0, 0.2)
+
+    status = ('EYE CONTACT ~{:.0f}deg'.format(gaze_info['threshold'])
+              if gaze_info['eye_contact'] else 'LOOK AWAY')
+    cv.putText(debug_image, status, (10, 58), cv.FONT_HERSHEY_SIMPLEX,
+               0.7, color, 2, cv.LINE_AA)
+    cv.putText(debug_image,
+               'ratio x:{:.2f} y:{:.2f}  angle x:{:.1f} y:{:.1f}'.format(
+                   gaze_info['ratio_x'], gaze_info['ratio_y'],
+                   gaze_info['angle_x'], gaze_info['angle_y']),
+               (10, 84), cv.FONT_HERSHEY_SIMPLEX, 0.55, color, 1, cv.LINE_AA)
+
+    return debug_image
+
+
